# ===== LLM =====
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_RETRIES=0

# ===== Busqueda =====
TAVILY_API_KEY=tu_api_key_de_tavily

# ===== Base de datos =====
# Desarrollo (SQLite):
DATABASE_URL=sqlite:///./backend/data/analisis_compras.db
# Entrega (MySQL) - descomenta y ajusta:
# DATABASE_URL=mysql+pymysql://app_user:password@localhost:3306/analisis_compras

# ===== API =====
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ===== Bot de Telegram =====
# Token de BotFather. Nunca lo subas a git.
TELEGRAM_BOT_TOKEN=123456:ABC...
# IDs numericos autorizados, separados por coma.
TELEGRAM_ALLOWED_USER_IDS=123456789
# fast = sin Gemini (recomendado); detallado = usa Gemini.
BOT_DEFAULT_MODE=fast
BOT_SESSION_TTL_HOURS=24
BOT_RATE_LIMIT_PER_HOUR=10
BOT_MAX_AUDIO_SECONDS=120
# auto = audio solo si la entrada fue voz; siempre; nunca.
BOT_VOICE_REPLY_MODE=auto
TELEGRAM_TTS_VOICE=es-MX-JorgeNeural
TELEGRAM_STT_MODEL=small
TELEGRAM_STT_DEVICE=cpu
TELEGRAM_STT_COMPUTE_TYPE=int8

# ===== Frontend (copiar a frontend/.env.local) =====
NEXT_PUBLIC_API_URL=http://localhost:8000
